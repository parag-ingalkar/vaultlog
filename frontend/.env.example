# Browser-facing API prefix (inlined at `next build`).
# Relative /api/v1 is recommended: the Next.js server proxies to FastAPI
# via API_PROXY_TARGET so refresh cookies stay first-party.
# Alternatively set an absolute origin that is listed in backend CORS_ORIGINS,
# e.g. http://localhost:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Server-only. FastAPI origin used by Next.js rewrites for /api/v1/*.
# Required whenever NEXT_PUBLIC_API_BASE_URL is a relative path.
API_PROXY_TARGET=http://localhost:8000
