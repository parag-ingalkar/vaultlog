# Runtime
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173
SERVICE_NAME=vaultlog-api

# Application database connection (RLS-enforced role)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=vaultlog
DATABASE_USER=vaultlog_app
DATABASE_PASSWORD=vaultlog_app_password

# Integration tests override DATABASE_NAME to vaultlog_test via tests/conftest.py.
# Do not set DATABASE_NAME=vaultlog_test in this file for local app development.
# Optional bootstrap credentials for creating vaultlog_test on first run (Compose defaults):
# TEST_DATABASE_BOOTSTRAP_USER=postgres_bootstrap
# TEST_DATABASE_BOOTSTRAP_PASSWORD=postgres_bootstrap_password

# Migration database connection (schema owner, used by Alembic only)
MIGRATION_DATABASE_USER=vaultlog_owner
MIGRATION_DATABASE_PASSWORD=vaultlog_owner_password

# JWT
JWT_ISSUER=vaultlog
JWT_AUDIENCE=vaultlog-api
JWT_PRIVATE_KEY_PEM_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PEM_PATH=./keys/jwt-public.pem
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_SECURE=false

# MFA — 32-byte key, base64-encoded. Generate locally; never commit real values.
MFA_KEK_B64=CHANGE_ME_32_BYTE_BASE64_KEY
STEP_UP_TOKEN_TTL_SECONDS=300
